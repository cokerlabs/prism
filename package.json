{
  "name": "prism",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @prism/web dev",
    "dev:worker": "wrangler dev",
    "build": "pnpm --filter @prism/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "check:worker": "wrangler deploy --dry-run --outdir=.wrangler/dry-run",
    "preview": "pnpm --filter @prism/web preview",
    "deploy": "pnpm build && wrangler deploy"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"]
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0"
  }
}
