        "primitive": {
          "type": "Annotation",
          "text": "Real wages here are nominal average hourly earnings divided by CPI-U, then expressed as a year-over-year percent change. Confirm the deflator (CPI-U vs PCE) before treating this as a take-home-pay claim.",
          "tone": "caveat",
